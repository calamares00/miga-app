<?xml version="1.0" encoding="utf-8"?>
<!-- App shortcut icon, in the colours of the app icon: launchers show shortcut icons on their own
     menu background, light or dark, so a bare dark glyph disappeared in dark mode. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/launcher_icon_background" />
    <foreground android:drawable="@drawable/ic_shortcut_new_recipe_foreground" />
</adaptive-icon>
